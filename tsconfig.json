{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/index.css", "src/types/index.ts", "src/services/financialScraper.ts", "src/services/htmlGenerator.ts", "src/components/CompanySelector.tsx", "src/pages/AnalysisPage.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
